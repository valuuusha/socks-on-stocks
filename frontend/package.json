{
  "name": "socks-on-stocks",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_START_URL=http://127.0.0.1:5173 electron .\"",
    "build:backend": "cd .. && python3 -m PyInstaller --noconfirm --clean --name socks-on-stocks-api --paths . --distpath dist/backend --workpath build/pyinstaller --specpath build/pyinstaller desktop/api_server.py",
    "desktop:package": "npm run build && npm run build:backend && electron-builder --mac --publish never"
  },
  "dependencies": {
    "lucide-react": "^1.21.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.socksonstocks.app",
    "productName": "Socks on Stocks",
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "extraResources": [{ "from": "../dist/backend/socks-on-stocks-api", "to": "backend/socks-on-stocks-api" }],
    "mac": { "target": ["dmg"], "category": "public.app-category.photography" }
  }
}
